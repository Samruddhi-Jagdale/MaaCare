{
  "info": {
    "_postman_id": "maacare-maternal-health-v2",
    "name": "MaaCare Maternal Healthcare Monitoring Platform API Collection",
    "description": "Comprehensive Postman test suite and API documentation for MaaCare v2.0. Includes automated assertions, role-based security tests, input validation, and negative testing scenarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "workerToken", "value": "", "type": "string" },
    { "key": "womanToken", "value": "", "type": "string" },
    { "key": "testWomanId", "value": "", "type": "string" },
    { "key": "testCheckupId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Health & Education",
      "item": [
        {
          "name": "Root Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('System is healthy', function () { var json = pm.response.json(); pm.expect(json.status).to.eql('healthy'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Education Guide (English)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/education?lang=en",
              "host": ["{{baseUrl}}"],
              "path": ["api", "education"],
              "query": [{ "key": "lang", "value": "en" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Has emergency warning signs', function () { pm.expect(pm.response.json().emergencyCare.dangerSigns.length).to.be.above(0); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Education Guide (Marathi)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/education?lang=mr",
              "host": ["{{baseUrl}}"],
              "path": ["api", "education"],
              "query": [{ "key": "lang", "value": "mr" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Has Marathi headline', function () { pm.expect(pm.response.json().emergencyCare.headline).to.include('आपत्कालीन'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Admin Login (Valid)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@maacare.org\",\n  \"password\": \"adminpassword123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test('Role is admin', function () { pm.expect(data.role).to.eql('admin'); });",
                  "pm.environment.set('adminToken', data.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Expectant Mother Registration (Valid)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Savita Patil\",\n  \"email\": \"savita.patil@test.org\",\n  \"phone\": \"9822114455\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 or 400 (if already exists)', function () {",
                  "  pm.expect([201, 400]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Registration Validation Failure (Invalid Email)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Invalid\",\n  \"email\": \"not-a-valid-email\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "pm.test('Validation message returned', function () { pm.expect(pm.response.json().message).to.include('valid email'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Registration Validation Failure (Short Password)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Short\",\n  \"email\": \"short@example.com\",\n  \"password\": \"123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login Failure (Wrong Password)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@maacare.org\",\n  \"password\": \"wrongpassword999\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized', function () { pm.response.to.have.status(401); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Admin Surveillance & Caseload",
      "item": [
        {
          "name": "Get Dashboard Statistics & Trends",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/stats", "host": ["{{baseUrl}}"], "path": ["api", "admin", "stats"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test('Contains totalWomen and workload', function () {",
                  "  pm.expect(data.totalWomen).to.be.a('number');",
                  "  pm.expect(data.workload).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Export Enrolled Mothers (CSV)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/export/women", "host": ["{{baseUrl}}"], "path": ["api", "admin", "export", "women"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Content-Type is text/csv', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Export Checkups Report (CSV)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/export/checkups", "host": ["{{baseUrl}}"], "path": ["api", "admin", "export", "checkups"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Contains CSV header', function () { pm.expect(pm.response.text()).to.include('Checkup Date'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Notifications",
      "item": [
        {
          "name": "Get User Notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/notifications", "host": ["{{baseUrl}}"], "path": ["api", "notifications"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Unread Count",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/notifications/unread-count", "host": ["{{baseUrl}}"], "path": ["api", "notifications", "unread-count"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('unreadCount returned', function () { pm.expect(pm.response.json().unreadCount).to.be.a('number'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Broadcast Announcement (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Immunization Camp Alert\",\n  \"message\": \"Tetanus & Calcium distribution camp on Thursday.\",\n  \"targetRole\": \"all\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/notifications/broadcast", "host": ["{{baseUrl}}"], "path": ["api", "notifications", "broadcast"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Security & Authorization Bounds",
      "item": [
        {
          "name": "Unauthenticated Request (401 Expected)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/admin/stats", "host": ["{{baseUrl}}"], "path": ["api", "admin", "stats"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', function () { pm.response.to.have.status(401); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Invalid JWT Token (401 Expected)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer invalid.jwt.token.here" }],
            "url": { "raw": "{{baseUrl}}/api/admin/stats", "host": ["{{baseUrl}}"], "path": ["api", "admin", "stats"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', function () { pm.response.to.have.status(401); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
